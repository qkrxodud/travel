{
  "name": "territory-frontend",
  "version": "0.0.1",
  "private": true,
  "description": "나의 영토(territory) 웹 프론트엔드 — Vite + React + TypeScript",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
