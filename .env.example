# 나의 영토 Docker Compose 운영 비밀값 — 복사해서 .env 로 쓰고 값을 채운다(.env 는 커밋 금지).
#   cp .env.example .env
# 강한 랜덤 값 예: openssl rand -base64 33 | tr -d '/+=' | cut -c1-40

# MySQL (DB_NAME 생략 시 territory)
DB_NAME=territory
DB_USERNAME=territory
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me

# 운영 API(/admin/**) 헤더 X-Admin-Token
TERRITORY_ADMIN_TOKEN=change-me

# 이번 주 미스터리 지역 주차 시드의 서버 비밀값(8단계) — 강한 랜덤 값. 모르면 다음 주 지역을 미리 셀 수 없다
TERRITORY_MYSTERY_SALT=change-me

# 분석(10단계) 탐험가 해시에 섞는 서버 비밀값 — 강한 랜덤 값(미스터리 값과 다르게). 한 번 정하면 바꾸지 않는다(바꾸면 코호트가 끊긴다)
TERRITORY_ANALYTICS_SALT=change-me

# 운영(prod)은 위 세 비밀값(관리자 토큰·미스터리·분석)이 16자 미만이거나 change-me·local- 같은 자리표시자면 기동하지 않는다.

# 분석 레이트 리밋이 믿는 프록시(CIDR, 쉼표). 비우면 아무도 믿지 않는다(실제 접속 주소로 센다).
# Cloudflare Tunnel(cloudflared)을 compose 네트워크에 붙일 때만 그 네트워크 대역 — doc/operations.md 10단계
TERRITORY_TRUSTED_PROXIES=

# 공개 기준 주소(og:image·og:url·OAuth redirect_uri). 로컬 운영은 http://localhost:18080, 도메인을 붙이면 https://...
TERRITORY_PUBLIC_BASE_URL=http://localhost:18080

# 구글 로그인(선택) — 비우면 로그인만 비활성(익명 탐험가는 정상). 리디렉션 URI: {TERRITORY_PUBLIC_BASE_URL}/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
